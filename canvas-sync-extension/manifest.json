{
  "manifest_version": 3,
  "name": "Study-OS Sync",
  "version": "1.7.2",
  "description": "One-click & auto-sync for university Canvas LMS courses, TimeEdit/TP timetables, Ed Discussion & opt-in local focus stats.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["scripting", "storage", "alarms"],
  "optional_permissions": ["tabs"],
  "host_permissions": [
    "https://canvas.bi.no/*",
    "https://*.instructure.com/*",
    "https://canvas.uia.no/*",
    "https://mitt.uib.no/*",
    "https://canvas.uio.no/*",
    "https://canvas.ntnu.no/*",
    "https://canvas.oslomet.no/*",
    "https://canvas.nhh.no/*",
    "https://canvas.uis.no/*",
    "https://canvas.uit.no/*",
    "https://canvas.usn.no/*",
    "https://canvas.nmbu.no/*",
    "https://canvas.hvl.no/*",
    "https://canvas.kristiania.no/*",
    "https://instructure-uploads-eu.s3.eu-west-1.amazonaws.com/*",
    "https://instructure-uploads-eu.s3.amazonaws.com/*",
    "https://instructure-uploads.s3.amazonaws.com/*",
    "https://cloud.timeedit.net/*",
    "https://tp.educloud.no/*",
    "https://tp.uio.no/*",
    "https://edstem.org/*",
    "https://eu.edstem.org/*",
    "https://us.edstem.org/*",
    "https://au.edstem.org/*",
    "https://shadjosef-study-os.shadjosef-study-os.workers.dev/*"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Sync Canvas, TimeEdit/TP & Ed to Study-OS",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://studyos.no/*",
        "https://shadjosef.github.io/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["studyos-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
