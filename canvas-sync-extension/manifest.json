{
  "manifest_version": 3,
  "name": "Study-OS Sync",
  "version": "1.5.1",
  "description": "One-click & optional auto-sync for BI Canvas courses, inline PDFs, TimeEdit schedules, and Ed Discussion directly to Study-OS.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["scripting", "storage"],
  "host_permissions": [
    "https://canvas.bi.no/*",
    "https://*.instructure.com/*",
    "https://instructure-uploads-eu.s3.eu-west-1.amazonaws.com/*",
    "https://instructure-uploads-eu.s3.amazonaws.com/*",
    "https://instructure-uploads.s3.amazonaws.com/*",
    "https://cloud.timeedit.net/*",
    "https://edstem.org/*",
    "https://eu.edstem.org/*",
    "https://us.edstem.org/*",
    "https://au.edstem.org/*",
    "https://shadjosef-study-os.shadjosef-study-os.workers.dev/*"
  ],
  "optional_host_permissions": [
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "Sync BI Canvas, TimeEdit & Ed to Study-OS",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://studyos.no/*",
        "https://shadjosef.github.io/*",
        "http://127.0.0.1/*",
        "http://localhost/*"
      ],
      "js": ["studyos-bridge.js"],
      "run_at": "document_idle"
    }
  ]
}
